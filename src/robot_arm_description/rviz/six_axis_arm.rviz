Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /Grid1/Status1
        - /RobotModel1
        - /TF1/Tree1
      Splitter Ratio: 0.5
    Tree Height: 685
Visualization Manager:
